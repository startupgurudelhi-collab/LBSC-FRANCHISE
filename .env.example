# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server & Runtime Configuration
PORT=3000
NODE_ENV="development"
API_PREFIX="/api/v1"
CORS_ORIGIN="*"
LOG_LEVEL="info"

# Database Configuration
# Supports file-based SQLite/LibSQL ("file:data/lbsc.db") or PostgreSQL ("postgresql://...")
DATABASE_URL="file:data/lbsc.db"
DATABASE_CLIENT="sqlite"

# Security & Secrets
JWT_SECRET="lbsc-default-development-secret-key-change-in-production"

# Phase 19: Efilingg Upstream Integration Configuration
# Mode: "DISABLED" (integration off), "SANDBOX" (simulated filing/ARN generation for QA), "LIVE" (real external API)
EFILINGG_MODE="SANDBOX"
EFILINGG_API_URL="https://api.efilingg.com/v1"
EFILINGG_API_KEY=""
EFILINGG_WEBHOOK_SECRET=""

# Phase 23B: Background Scheduler Configuration
# Controls whether automatic background scheduling timers are enabled (default: true)
ENABLE_BACKGROUND_SCHEDULER="true"

# Phase 23C.1: Multi-Channel Notification Delivery Configuration
# Default all external delivery channels to false
NOTIFICATION_WHATSAPP_ENABLED="false"
NOTIFICATION_SMS_ENABLED="false"
NOTIFICATION_EMAIL_ENABLED="false"
# Provider mode: "MOCK" (simulates delivery), "LOG_ONLY" (logs delivery payload), "DISABLED" (delivery disabled)
NOTIFICATION_PROVIDER_MODE="MOCK"

